<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1440" width="1024" height="1440">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@400;600;700;800;900&amp;display=swap');
      .font-main { font-family: 'Prompt', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    </style>
    <linearGradient id="backBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="50%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
    <linearGradient id="qrBorderGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF5E62" />
      <stop offset="50%" stop-color="#FFA259" />
      <stop offset="100%" stop-color="#3B82F6" />
    </linearGradient>
    <filter id="qrShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Dark Aesthetic Card Background -->
  <rect width="1024" height="1440" fill="url(#backBg)" rx="44" ry="44" />
  <rect x="2" y="2" width="1020" height="1436" fill="none" stroke="#334155" stroke-width="4" rx="42" ry="42" />

  <!-- Top Punch Slot Area -->
  <rect x="422" y="45" width="180" height="24" rx="12" ry="12" fill="#000000" opacity="0.4" />

  <!-- Header Badge -->
  <g transform="translate(512, 140)">
    <rect x="-160" y="-22" width="320" height="44" rx="22" fill="#1E293B" stroke="#3B82F6" stroke-width="2" />
    <circle cx="-130" cy="0" r="6" fill="#00E676" />
    <text x="10" y="7" text-anchor="middle" class="font-main" font-size="18" font-weight="800" fill="#93C5FD" letter-spacing="2">DIGITAL PASS • RESUME</text>
  </g>

  <!-- Title -->
  <text x="512" y="235" text-anchor="middle" class="font-main" font-size="44" font-weight="900" fill="#FFFFFF" letter-spacing="-0.5">สแกนดาวน์โหลดเรซูเม่</text>
  <text x="512" y="280" text-anchor="middle" class="font-main" font-size="22" font-weight="600" fill="#94A3B8" letter-spacing="0.5">Scan with phone camera to download Resume (PDF)</text>

  <!-- QR Code Frame & Image -->
  <g transform="translate(512, 540)" filter="url(#qrShadow)">
    <!-- Outer Glow Gradient Border -->
    <rect x="-224" y="-224" width="448" height="448" rx="36" fill="url(#qrBorderGrad)" />
    <!-- White QR Pad -->
    <rect x="-216" y="-216" width="432" height="432" rx="30" fill="#FFFFFF" />
    <!-- QR Code Graphic -->
    <image href="data:image/png;base64," x="-190" y="-190" width="380" height="380" preserveAspectRatio="xMidYMid meet" />
    <!-- Center Logo Shield -->
    <circle cx="0" cy="0" r="34" fill="#FFFFFF" />
    <circle cx="0" cy="0" r="28" fill="#0F172A" />
    <text x="0" y="8" text-anchor="middle" font-family="sans-serif" font-size="20" font-weight="900" fill="#FFA259">PDF</text>
  </g>

  <!-- Section Label -->
  <text x="512" y="820" text-anchor="middle" class="font-main" font-size="20" font-weight="800" fill="#64748B" letter-spacing="2">SHORTCUTS &amp; LINKS</text>

  <!-- 4 Shortcut Rows (2x2 Grid) -->
  <g transform="translate(132, 850)">
    <!-- Item 1: GitHub -->
    <g transform="translate(0, 0)">
      <rect width="360" height="76" rx="20" fill="#1E293B" stroke="#334155" stroke-width="2" />
      <circle cx="42" cy="38" r="22" fill="#0F172A" />
      <path d="M42 24 C34.268 24 28 30.268 28 38 C28 44.185 32.011 49.432 37.587 51.285 C38.287 51.414 38.542 50.982 38.542 50.61 C38.542 50.278 38.531 49.398 38.524 48.229 C34.629 49.076 33.807 46.353 33.807 46.353 C33.17 44.731 32.25 44.3 32.25 44.3 C30.978 43.431 32.346 43.448 32.346 43.448 C33.752 43.546 34.49 44.891 34.49 44.891 C35.74 47.033 37.768 46.415 38.566 46.058 C38.695 45.152 39.057 44.534 39.458 44.183 C36.347 43.83 33.076 42.628 33.076 37.255 C33.076 35.724 33.623 34.469 34.52 33.489 C34.375 33.135 33.894 31.708 34.658 29.779 C34.658 29.779 35.835 29.402 38.51 31.215 C39.628 30.904 40.824 30.749 42.013 30.743 C43.201 30.749 44.397 30.904 45.517 31.215 C48.19 29.402 49.365 29.779 49.365 29.779 C50.131 31.708 49.65 33.135 49.506 33.489 C50.404 34.469 50.947 35.724 50.947 37.255 C50.947 42.642 47.67 43.826 44.55 44.172 C45.053 44.605 45.5 45.46 45.5 46.766 C45.5 48.636 45.483 50.147 45.483 50.61 C45.483 50.986 45.735 51.423 46.444 51.284 C52.016 49.427 56.023 44.183 56.023 38 C56.023 30.268 49.755 24 42 24 Z" fill="#FFFFFF" />
      <text x="80" y="36" class="font-main" font-size="20" font-weight="800" fill="#F8FAFC">GitHub</text>
      <text x="80" y="58" class="font-main" font-size="15" font-weight="600" fill="#94A3B8">Thanakrit8448</text>
    </g>

    <!-- Item 2: LinkedIn -->
    <g transform="translate(400, 0)">
      <rect width="360" height="76" rx="20" fill="#1E293B" stroke="#334155" stroke-width="2" />
      <circle cx="42" cy="38" r="22" fill="#0A66C2" />
      <text x="42" y="47" text-anchor="middle" font-family="sans-serif" font-size="24" font-weight="900" fill="#FFFFFF">in</text>
      <text x="80" y="36" class="font-main" font-size="20" font-weight="800" fill="#F8FAFC">LinkedIn</text>
      <text x="80" y="58" class="font-main" font-size="15" font-weight="600" fill="#94A3B8">Thanakrit Eungpairoh</text>
    </g>

    <!-- Item 3: TikTok -->
    <g transform="translate(0, 96)">
      <rect width="360" height="76" rx="20" fill="#1E293B" stroke="#334155" stroke-width="2" />
      <circle cx="42" cy="38" r="22" fill="#000000" stroke="#25F4EE" stroke-width="1.5" />
      <text x="42" y="46" text-anchor="middle" font-family="sans-serif" font-size="22" font-weight="900" fill="#FE2C55">♪</text>
      <text x="80" y="36" class="font-main" font-size="20" font-weight="800" fill="#F8FAFC">TikTok</text>
      <text x="80" y="58" class="font-main" font-size="15" font-weight="600" fill="#94A3B8">@icelandkung</text>
    </g>

    <!-- Item 4: Phone & Email -->
    <g transform="translate(400, 96)">
      <rect width="360" height="76" rx="20" fill="#1E293B" stroke="#334155" stroke-width="2" />
      <circle cx="42" cy="38" r="22" fill="#10B981" />
      <text x="42" y="46" text-anchor="middle" font-size="20">📞</text>
      <text x="80" y="36" class="font-main" font-size="19" font-weight="800" fill="#F8FAFC">093-583-9658</text>
      <text x="80" y="58" class="font-main" font-size="15" font-weight="600" fill="#94A3B8">icekung8448@gmail.com</text>
    </g>
  </g>

  <!-- Bottom Flip Hint / ID Card Footer -->
  <g transform="translate(512, 1170)">
    <rect x="-240" y="-30" width="480" height="60" rx="30" fill="#FFFFFF" />
    <circle cx="-190" cy="0" r="14" fill="#3B82F6" />
    <text x="-190" y="5" text-anchor="middle" font-size="14" fill="#FFFFFF">🔄</text>
    <text x="15" y="7" text-anchor="middle" class="font-main" font-size="21" font-weight="800" fill="#0F172A" letter-spacing="0.5">แตะหรือคลิกเพื่อพลิกกลับด้านหน้า</text>
  </g>

  <!-- Bottom Card Info -->
  <text x="512" y="1300" text-anchor="middle" class="font-main" font-size="18" font-weight="800" fill="#F8FAFC" letter-spacing="1">THANAKRIT EUNGPAIROH</text>
  <text x="512" y="1340" text-anchor="middle" class="font-main" font-size="14" font-weight="600" fill="#64748B" letter-spacing="3">PORTFOLIO &amp; INTERACTIVE 3D LANYARD</text>
</svg>